<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Verification-mode receipt photos and OCR logs never leave the device via backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="scan_log/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="scan_log/" />
    </device-transfer>
</data-extraction-rules>
